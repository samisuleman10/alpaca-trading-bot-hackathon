# Market data is not ours to redistribute, and it is large.
# Until Alpaca's terms are checked, nothing under data/ is committed.
data/
!data/.gitkeep

# The design documents are kept out of the repository for now, at Sami's
# request. They still exist on disk and are still the authority on what is
# being built -- they are simply not tracked here yet. The README links to
# them, so this has to be revisited before the repository is made public.
docs/

# Secrets. There is never a reason for one of these to be in this repository.
.env
.env.*
*.key
*.pem

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Node / Next.js
node_modules/
.next/
out/
.vercel/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
